rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these Google accounts can read, edit or delete applications.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['sarkartax82@gmail.com'];
    }

    match /enquiries/{id} {
      // Anyone can submit a new application (the website form), nobody can read others' data.
      allow create: if request.resource.data.keys().hasOnly(
            ['ref','service','serviceLabel','items','name','mobile','email','city','business','answers','notes','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.notes.size() <= 1000;

      allow read, update, delete: if isAdmin();
    }
  }
}
