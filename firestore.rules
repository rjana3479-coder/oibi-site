rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only this Google account can read, edit or delete applications.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['biplab876821@gmail.com'];
    }

    // Full applications: customers can only submit, never read.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['ref','service','serviceLabel','items','name','mobile','email','city','business','answers','notes','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.notes.size() <= 1000;

      allow read, update, delete: if isAdmin();
    }

    // Public status lookup: holds only a status word, no personal data.
    // A customer can look up one reference number but cannot list them.
    match /status/{ref} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (
            ref.matches('^OIBI-[0-9]{6}-[A-Z0-9]{4}$')
            && request.resource.data.keys().hasOnly(['status','updatedAt'])
            && request.resource.data.status == 'new'
            && request.resource.data.updatedAt == request.time);
      allow update, delete: if isAdmin();
    }
  }
}
